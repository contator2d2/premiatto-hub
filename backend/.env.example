# ============================================
# Premiatto Connect — Backend
# ============================================

# Banco de dados PostgreSQL (obrigatório)
DATABASE_URL="postgresql://premiatto:premiatto@postgres:5432/premiatto?schema=public"

# Servidor
PORT=3000
NODE_ENV=production

# CORS — lista separada por vírgula, com esquema http(s)://
CORS_ORIGIN="http://localhost:5173"

# JWT — troque JWT_SECRET por uma string aleatória com >= 32 caracteres
# ex: openssl rand -hex 48
JWT_SECRET="troque-por-uma-string-aleatoria-com-no-minimo-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Uploads — deve apontar para um volume persistente (Easypanel)
UPLOADS_DIR="/data/uploads"

# Super Admin criado no primeiro boot (seed)
SUPER_ADMIN_EMAIL="admin@premiatto.com.br"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
SUPER_ADMIN_NAME="Administrador"
