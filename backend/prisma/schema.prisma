generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  super_admin
  admin
  gestor
  colaborador
  correspondente
  franqueado
}

enum UserStatus {
  active
  inactive
  pending
}

enum Confidentiality {
  public
  internal
  confidential
  restricted
}

enum SharePriority {
  normal
  important
  urgent
}

enum ShareScope {
  user
  department
  role
  all
}

enum ShareStatus {
  delivered
  viewed
  opened
  acknowledged
}

enum PublicLinkStatus {
  active
  expired
  revoked
  blocked
}

enum PolicyStatus {
  draft
  active
  inactive
  archived
}

enum PolicyInheritance {
  full
  partial
  exception
  override
  locked
}

enum PolicyExceptionStatus {
  pending
  approved
  rejected
  expired
}


model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String?
  phone        String?
  jobTitle     String?
  avatarUrl    String?
  status       UserStatus @default(active)
  companyId    String?
  departmentId String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company     Company?    @relation(fields: [companyId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  roles       UserRole[]
  documents   Document[]  @relation("DocCreatedBy")
  auditLogs   AuditLog[]
  favorites   DocumentFavorite[]
  acknowledgements DocumentAcknowledgement[]
  refreshTokens RefreshToken[]
  accessOverride UserAccessOverride?
  notifications  Notification[]
  sharesCreated  DocumentShare[]     @relation("ShareCreator")
  sharesReceived DocumentShare[]     @relation("ShareTarget")
  publicLinks    DocumentPublicLink[]
  events         DocumentEvent[]
}

model AccessTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  moduleKeys  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleDefaults  RoleAccessTemplate[]
  userOverrides UserAccessOverride[]
}

model RoleAccessTemplate {
  role       AppRole @id
  templateId String
  template   AccessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model UserAccessOverride {
  userId     String   @id
  templateId String?
  moduleKeys String[] @default([])
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template AccessTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model UserRole {
  id     String  @id @default(uuid())
  userId String
  role   AppRole
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  departments Department[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String?
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id])
  users     User[]
  folders   Folder[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  documents Document[]
}

model Folder {
  id           String   @id @default(uuid())
  name         String
  parentId     String?
  description  String?
  tags         String[] @default([])
  isOfficial   Boolean  @default(false)
  departmentId String?
  createdBy    String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  policyId          String?
  policyInheritance PolicyInheritance @default(full)

  parent     Folder?     @relation("FolderChildren", fields: [parentId], references: [id])
  children   Folder[]    @relation("FolderChildren")
  department Department? @relation(fields: [departmentId], references: [id])
  policy     DocumentPolicy? @relation(fields: [policyId], references: [id])
  documents  Document[]
}

model Document {
  id                     String   @id @default(uuid())
  name                   String
  description            String?
  filePath               String
  fileType               String?
  fileSize               Int?
  mimeType               String?
  isOfficial             Boolean  @default(false)
  requiresAcknowledgement Boolean @default(false)
  allowDownload          Boolean  @default(true)
  allowShare             Boolean  @default(true)
  confidentiality        Confidentiality @default(internal)
  author                 String?
  tags                   String[] @default([])
  downloadCount          Int      @default(0)
  viewCount              Int      @default(0)
  version                Int      @default(1)
  categoryId             String?
  folderId               String?
  responsibleId          String?
  publishedAt            DateTime?
  validUntil             DateTime?
  isDeleted              Boolean  @default(false)
  deletedAt              DateTime?
  createdBy              String
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  policyId               String?
  policyInheritance      PolicyInheritance @default(full)
  policyLocked           Boolean  @default(false)

  category   Category? @relation(fields: [categoryId], references: [id])
  folder     Folder?   @relation(fields: [folderId], references: [id])
  policy     DocumentPolicy? @relation(fields: [policyId], references: [id])
  creator    User      @relation("DocCreatedBy", fields: [createdBy], references: [id])
  versions   DocumentVersion[]
  shares     DocumentShare[]
  publicLinks DocumentPublicLink[]
  acknowledgements DocumentAcknowledgement[]
  favorites  DocumentFavorite[]
  events     DocumentEvent[]
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  version       Int
  filePath      String
  fileSize      Int?
  mimeType      String?
  fileType      String?
  isCurrent     Boolean  @default(false)
  changeReason  String?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, version])
}

model DocumentShare {
  id                String       @id @default(uuid())
  documentId        String
  scope             ShareScope   @default(user)
  targetUserId      String?
  targetDepartmentId String?
  targetRole        AppRole?
  message           String?
  priority          SharePriority @default(normal)
  requireAck        Boolean      @default(false)
  allowDownload     Boolean      @default(true)
  allowReshare      Boolean      @default(false)
  dueAt             DateTime?
  status            ShareStatus  @default(delivered)
  versionAtShare    Int?
  deliveredAt       DateTime     @default(now())
  viewedAt          DateTime?
  openedAt          DateTime?
  acknowledgedAt    DateTime?
  createdBy         String
  createdAt         DateTime     @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation("ShareCreator", fields: [createdBy], references: [id])
  target   User?    @relation("ShareTarget", fields: [targetUserId], references: [id])
}

model DocumentPublicLink {
  id             String   @id @default(uuid())
  documentId     String
  token          String   @unique
  passwordHash   String?
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  recipientCompany String?
  allowDownload  Boolean  @default(false)
  requireAck     Boolean  @default(false)
  requireIdentify Boolean @default(false)
  blockPrint     Boolean  @default(false)
  expiresAt      DateTime?
  maxAccesses    Int?
  accessCount    Int      @default(0)
  failedAttempts Int      @default(0)
  status         PublicLinkStatus @default(active)
  revokedAt      DateTime?
  notes          String?
  createdBy      String
  createdAt      DateTime @default(now())
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator        User     @relation(fields: [createdBy], references: [id])
  accesses       PublicLinkAccess[]
}

model PublicLinkAccess {
  id          String   @id @default(uuid())
  linkId      String
  action      String
  ip          String?
  userAgent   String?
  actorName   String?
  actorEmail  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  link        DocumentPublicLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model DocumentAcknowledgement {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  version    Int      @default(1)
  ip         String?
  userAgent  String?
  acknowledgedAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([documentId, userId, version])
}

model DocumentFavorite {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([documentId, userId])
}

model DocumentEvent {
  id         String   @id @default(uuid())
  documentId String
  versionId  String?
  userId     String?
  actorType  String   @default("user")
  actorLabel String?
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
  @@index([documentId, createdAt])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  url        String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model Branding {
  id            String   @id @default("singleton")
  appName       String   @default("Premiatto Connect")
  primaryColor  String   @default("#0B3D91")
  accentColor   String   @default("#1E88E5")
  logoUrl       String?
  logoDarkUrl   String?
  faviconUrl    String?
  tagline       String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

model DocumentPolicy {
  id              String       @id @default(uuid())
  name            String       @unique
  description     String?
  category        String?
  status          PolicyStatus @default(draft)
  priority        Int          @default(100)
  responsibleId   String?
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  conditions      Json         @default("{}")
  permissions     Json         @default("{}")
  sharingRules    Json         @default("{}")
  securityRules   Json         @default("{}")
  readingRules    Json         @default("{}")
  versioningRules Json         @default("{}")
  retentionRules  Json         @default("{}")
  isSystem        Boolean      @default(false)
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  folders    Folder[]
  documents  Document[]
  exceptions PolicyException[]
  audits     PolicyAudit[]
}

model SharePreset {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  config      Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PolicyException {
  id              String                @id @default(uuid())
  policyId        String
  documentId      String?
  requestedBy     String
  reason          String
  requestedAction String
  expiresAt       DateTime?
  status          PolicyExceptionStatus @default(pending)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  policy DocumentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

model PolicyAudit {
  id        String   @id @default(uuid())
  policyId  String?
  action    String
  userId    String?
  before    Json?
  after     Json?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  policy DocumentPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
}
